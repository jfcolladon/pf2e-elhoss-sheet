{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode gzip
	request_body {
		max_size 2MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
	reverse_proxy pf2e-sheet:8000 {
		header_up X-Real-IP {remote_host}
	}
}
