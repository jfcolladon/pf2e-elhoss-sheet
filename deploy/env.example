# Copiar a deploy/.env (ese archivo no se commitea).
# docker compose -f docker-compose.prod.yml --env-file deploy/.env up -d --build

AUTH_USER=elhoss
AUTH_PASSWORD=cambia-esto

# Vacío = HTTP en puerto 80 (sin certificado).
# Cuando tengas DuckDNS: SITE_DOMAIN=tu-subdominio.duckdns.org
SITE_DOMAIN=
ACME_EMAIL=you@example.com

# Tras HTTPS: CORS_ORIGINS=https://tu-subdominio.duckdns.org
CORS_ORIGINS=*

# Opcional, para el cron de IP efímera (ver deploy/duckdns-update.sh)
# DUCKDNS_DOMAIN=tu-subdominio
# DUCKDNS_TOKEN=
